# @BotFather bergan token
BOT_TOKEN=123456789:AA...
# Sizning Telegram ID raqamingiz (@userinfobot dan bilib olasiz). Buyurtmalar, usta arizalari va pul yechish so'rovlari shu yerga keladi.
ADMIN_ID=
# Mini App manzili (HTTPS bo'lishi shart), masalan https://tuzataman.onrender.com/
WEBAPP_URL=
PORT=8080
# Yangi tasdiqlangan ustaga beriladigan bonus (so'm)
WELCOME_BONUS=25000
# mock = sinov (haqiqiy pul yo'q). Octo/Click shartnomasidan keyin: octo
PAYMENTS=mock
# Faqat kompyuterda sinash uchun 1 qiling, serverda 0 qoldiring
DEV_MODE=0
# Botning username'i (@ belgisisiz), kanal tugmalari uchun
BOT_USERNAME=
# Post joylanadigan kanal
CHANNEL=@tuzataman_uz
# Render kabi uxlab qoladigan hostingda 1 qiling (Telegram o'zi serverni uyg'otadi)
WEBHOOK=0
# file = diskda saqlash; telegram = bazani admin chatidagi qadalgan faylda saqlash (bepul hosting uchun)
STORAGE=file
